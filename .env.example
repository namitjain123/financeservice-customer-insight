# Copy this file to .env and fill in your key. Never commit .env.
#
# Get a free Gemini API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- optional overrides ------------------------------------------------------
# CHAT_MODEL=gemini-2.5-flash
# EMBED_MODEL=gemini-embedding-001
# EMBED_DIMENSIONS=1536

# To swap providers, override the base URL and model names. The code is
# provider-agnostic because it speaks the OpenAI-compatible protocol.
#
# Groq:    GEMINI_BASE_URL=https://api.groq.com/openai/v1
#          CHAT_MODEL=llama-3.3-70b-versatile
#          EMBED_MODEL=nomic-embed-text-v1_5
#
# OpenAI:  GEMINI_BASE_URL=https://api.openai.com/v1
#          CHAT_MODEL=gpt-4o-mini
#          EMBED_MODEL=text-embedding-3-small
