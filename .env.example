# Copy this file to .env and fill in your keys. Never commit .env.
#
# Get a free Gemini API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Embeddings use a SEPARATE provider from chat - Gemini's free-tier embedding
# quota is a hard daily cap with an unpredictable reset time, while chat has
# its own separate quota and is unaffected. Get a free Voyage AI key (no
# payment method required) at: https://dash.voyageai.com
VOYAGE_API_KEY=

# --- optional overrides ------------------------------------------------------
# CHAT_MODEL=gemini-2.5-flash
# EMBED_MODEL=voyage-4-lite
# EMBED_DIMENSIONS=1024

# To swap the CHAT provider, override the base URL and model name. The code
# is provider-agnostic because it speaks the OpenAI-compatible protocol.
#
# Groq (chat only - Groq does not offer an embeddings API):
#          GEMINI_BASE_URL=https://api.groq.com/openai/v1
#          CHAT_MODEL=llama-3.3-70b-versatile
#
# OpenAI (works for both chat and embeddings):
#          GEMINI_BASE_URL=https://api.openai.com/v1
#          CHAT_MODEL=gpt-4o-mini
#          EMBED_BASE_URL=https://api.openai.com/v1
#          VOYAGE_API_KEY=<your openai key - reused here since this var name
#                          is just "whatever key the embed client uses">
#          EMBED_MODEL=text-embedding-3-small
